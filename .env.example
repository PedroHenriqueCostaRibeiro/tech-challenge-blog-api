# Servidor
PORT=3000

# Banco de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=blog

# Sincroniza o schema automaticamente a partir das entidades (use apenas em dev).
# Em producao, prefira migrations e deixe como false.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Autenticacao (JWT)
# JWT_SECRET assina e valida os tokens. NAO existe valor padrao no codigo:
# quem conhece o segredo pode forjar um token de professor e escrever no blog.
# Em producao, gere um valor longo e aleatorio, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-valor-em-producao
JWT_EXPIRES_IN=8h
